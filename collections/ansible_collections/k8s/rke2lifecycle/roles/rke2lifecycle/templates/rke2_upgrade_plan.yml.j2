---
apiVersion: upgrade.cattle.io/v1
kind: Plan
metadata:
  name: "{{ rke2lifecycle_upgrade_plan_name }}"
  namespace: "{{ rke2lifecycle_upgrade_namespace }}"
  labels:
    app.kubernetes.io/managed-by: ansible
    app.kubernetes.io/part-of: rke2-upgrade
  annotations:
    awx.ansible.com/requested-version: "{{ rke2lifecycle_target_version }}"
    awx.ansible.com/snapshot-operation: "{{ rke2lifecycle_snapshot_operation_name }}"
spec:
  concurrency: {{ rke2lifecycle_upgrade_concurrency | int }}
  cordon: {{ rke2lifecycle_upgrade_cordon | bool | lower }}
  nodeSelector:
    matchExpressions:
      - key: node-role.kubernetes.io/control-plane
        operator: Exists
  serviceAccountName: "{{ rke2lifecycle_upgrade_service_account_name }}"
  tolerations:
    - operator: Exists
  upgrade:
    image: rancher/rke2-upgrade
  version: "{{ rke2lifecycle_target_version }}"
